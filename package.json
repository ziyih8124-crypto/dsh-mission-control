{
  "name": "@local/dsh-mission-control",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A DSH session view that puts the lead agent and its subagents on one mission-control board and lets the user dispatch new subagents on demand.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
